# Database
# For Supabase connection pooler (port 6543): append ?pgbouncer=true&statement_cache_size=0
# statement_cache_size=0 is required to avoid "prepared statement already exists" errors with PgBouncer
# DIRECT_URL should use the direct connection (port 5432) for migrations
DATABASE_URL="postgresql://user:password@localhost:5432/pipeline_constructor?pgbouncer=true&statement_cache_size=0"
DIRECT_URL="postgresql://user:password@localhost:5432/pipeline_constructor"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Encryption (32-byte hex string for AES-256-GCM)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# App
NEXTAUTH_SECRET="your-secret"
NEXTAUTH_URL="http://localhost:3000"
